#!/usr/bin/env bash
# pdf — papkadagi rasmlarni (kitob sahifalari) ketma-ketlikda bitta PDF ga jamlash (Termux).
#
#   pdf                     Download/Kitob papkasidagi rasmlar → Download/Kitob/Kitob.pdf
#   pdf <papka>             shu papkadagi rasmlar → <papka>/<papka nomi>.pdf
#   pdf <papka> <nom>       PDF nomi ixtiyoriy: <papka>/<nom>.pdf
#   pdf -k …                ixcham: rasm eni 1800 px gacha, sifat 80 (odatda 3–6 barobar kichik)
#   pdf -kk …               juda ixcham: 1400 px, oq-qora (kulrang), sifat 65 (odatda 8–15 barobar kichik)
#   pdf -r …                rasm ichidagi aylantirish belgisini inobatga olmaslik
#   pdf -o …                OCR: matnni taniydi — PDF ichidan qidirish/nusxalash mumkin + .txt fayl
#   pdf -o -l uzb …         OCR tili: tur (standart), uzb, uzb_cyrl, eng; bir nechtasi: tur+eng
#
# Tartib: fayl nomi boʻyicha, raqamlar toʻgʻri (1, 2, … 9, 10, 11 — 1, 10, 11, 2 emas).
# JPEG rasmlar qayta siqilmaydi (sifat oʻzgarmaydi). Telefon rasmlarining burilishi (EXIF) toʻgʻrilanadi.
# PNG/WEBP/BMP ham qabul qilinadi. Asl rasmlarga tegilmaydi.
# OCR (-o) rasmlarni Tesseract bilan oʻqiydi: birinchi marta dastur va til maʼlumoti (~5–40 MB)
# oʻzi yuklanadi, keyin internetsiz ishlaydi. Telefonda ~5–20 soniya/sahifa.

PY="${YT_PYTHON:-python}"
if [ -t 1 ]; then
  B=$'\e[1m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' C=$'\e[36m' N=$'\e[0m'
else
  B="" G="" Y="" R="" C="" N=""
fi
say()  { printf '%s\n' "${C}›${N} $*"; }
ok()   { printf '%s\n' "${G}✔${N} $*"; }
warn() { printf '%s\n' "${Y}!${N} $*"; }
err()  { printf '%s\n' "${R}✖ $*${N}" >&2; }

PYCODE='
import os, re, sys, io, zlib
from PIL import Image, ImageOps
Image.MAX_IMAGE_PIXELS = None
folder, out, lvl, norot = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4] == "1"
cap, q, gray = {0: None, 1: 1800, 2: 1400}[lvl], {0: 95, 1: 80, 2: 65}[lvl], lvl == 2
exts = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff")
def nat(s): return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]
files = sorted((f for f in os.listdir(folder) if f.lower().endswith(exts) and not f.startswith(".")), key=nat)
if not files:
    print("EMPTY"); sys.exit(3)
orig = 0

objs = []   # har element — bytes (obyekt tanasi)
def add(b): objs.append(b); return len(objs)       # obyekt raqami (1 dan)
add(b"")  # 1: Catalog (keyin toʻldiriladi)
add(b"")  # 2: Pages
page_ids = []
skipped = []
for name in files:
    path = os.path.join(folder, name)
    try:
        im = Image.open(path)
        fmt = im.format
        orient = 1 if norot else (im.getexif().get(274, 1) or 1)
        w, h = im.size
        raw = None
        if fmt == "JPEG" and orient == 1 and im.mode in ("RGB", "L") and lvl == 0:
            raw = open(path, "rb").read(); cs = b"/DeviceRGB" if im.mode == "RGB" else b"/DeviceGray"
        if raw is None:
            im.load()
            if not norot: im = ImageOps.exif_transpose(im)
            if im.mode in ("RGBA", "LA", "P"):
                im = im.convert("RGBA"); bg = Image.new("RGB", im.size, "white"); bg.paste(im, mask=im.split()[3]); im = bg
            elif im.mode not in ("RGB", "L"):
                im = im.convert("RGB")
            if gray and im.mode != "L":
                im = ImageOps.autocontrast(im.convert("L"), cutoff=1)
            if cap and im.width > cap:
                im = im.resize((cap, round(im.height * cap / im.width)), Image.LANCZOS)
            buf = io.BytesIO(); im.save(buf, "JPEG", quality=q, optimize=True, subsampling=0 if lvl == 0 else 2)
            raw = buf.getvalue(); w, h = im.size; cs = b"/DeviceRGB" if im.mode == "RGB" else b"/DeviceGray"
    except Exception as e:
        skipped.append(name); continue
    orig += os.path.getsize(path)
    pw, ph = w * 72 / 150.0, h * 72 / 150.0          # 150 dpi
    img_id = add(b"<< /Type /XObject /Subtype /Image /Width %d /Height %d /ColorSpace %s /BitsPerComponent 8 /Filter /DCTDecode /Length %d >>\nstream\n" % (w, h, cs, len(raw)) + raw + b"\nendstream")
    content = b"q %.2f 0 0 %.2f 0 0 cm /Im0 Do Q" % (pw, ph)
    cont_id = add(b"<< /Length %d >>\nstream\n" % len(content) + content + b"\nendstream")
    page_id = add(b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 %.2f %.2f] /Resources << /XObject << /Im0 %d 0 R >> >> /Contents %d 0 R >>" % (pw, ph, img_id, cont_id))
    page_ids.append(page_id)
if not page_ids:
    print("NOPAGES"); sys.exit(4)
objs[0] = b"<< /Type /Catalog /Pages 2 0 R >>"
objs[1] = b"<< /Type /Pages /Count %d /Kids [%s] >>" % (len(page_ids), b" ".join(b"%d 0 R" % i for i in page_ids))
tmp = out + ".tmp"
with open(tmp, "wb") as f:
    f.write(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
    offs = []
    for i, b in enumerate(objs, 1):
        offs.append(f.tell()); f.write(b"%d 0 obj\n" % i + b + b"\nendobj\n")
    x = f.tell()
    f.write(b"xref\n0 %d\n0000000000 65535 f \n" % (len(objs) + 1))
    for o in offs: f.write(b"%010d 00000 n \n" % o)
    f.write(b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (len(objs) + 1, x))
os.replace(tmp, out)
print("OK", len(page_ids), os.path.getsize(out), orig, ",".join(skipped))
'

PYNORM='
import os, re, sys
from PIL import Image, ImageOps
Image.MAX_IMAGE_PIXELS = None
folder, outdir, lvl, norot = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4] == "1"
exts = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff")
def nat(s): return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]
files = sorted((f for f in os.listdir(folder) if f.lower().endswith(exts) and not f.startswith(".")), key=nat)
cap = {0: 3000, 1: 1800, 2: 1400}[lvl]       # OCR uchun yetarli (~300 dpi), tezroq
n, skipped, lst = 0, [], []
for name in files:
    try:
        im = Image.open(os.path.join(folder, name)); im.load()
        if not norot: im = ImageOps.exif_transpose(im)
        if im.mode in ("RGBA", "LA", "P"):
            im = im.convert("RGBA"); bg = Image.new("RGB", im.size, "white"); bg.paste(im, mask=im.split()[3]); im = bg
        elif im.mode not in ("RGB", "L"):
            im = im.convert("RGB")
        if im.width > cap: im = im.resize((cap, round(im.height * cap / im.width)), Image.LANCZOS)
        n += 1; p = os.path.join(outdir, "%05d.jpg" % n)
        im.save(p, "JPEG", quality=92 if lvl == 0 else 85, dpi=(300, 300)); lst.append(p)
    except Exception:
        skipped.append(name)
open(os.path.join(outdir, "list.txt"), "w").write("\n".join(lst) + "\n")
print(n, ",".join(skipped))
'

human() { awk -v b="$1" 'BEGIN { split("B KB MB GB", u); i = 1; while (b >= 1024 && i < 4) { b /= 1024; i++ }; printf (i > 2 ? "%.1f %s" : "%d %s"), b, u[i] }'; }

# ---------- OCR ----------

TESSDIR=""
TESSDATA_URL="${TESSDATA_URL:-https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/main}"

ocr_setup() {
  local lang="$1" l
  if ! command -v tesseract >/dev/null; then
    say "Tesseract (OCR dasturi) oʻrnatilmoqda — bir marta…"
    command -v pkg >/dev/null && yes | pkg install -y tesseract >/dev/null 2>&1
    command -v tesseract >/dev/null || { err "Tesseract oʻrnatilmadi. Termux'da: pkg install tesseract"; return 1; }
  fi
  # Tesseract'ning oʻz maʼlumotlar papkasi (til fayllari, configs/, pdf.ttf shu yerda). Yozib boʻlmasa — nusxasi.
  local sys
  sys=$(tesseract --list-langs 2>&1 | sed -n '1s/^[^"]*"\(.*\)".*$/\1/p'); sys="${sys%/}"
  if [ -z "${TESSDATA_DIR:-}" ] && [ -n "$sys" ] && [ -w "$sys" ]; then
    TESSDIR="$sys"
  else
    TESSDIR="${TESSDATA_DIR:-$HOME/.local/share/tessdata}"
    mkdir -p "$TESSDIR"
    [ -n "$sys" ] && [ -d "$sys" ] && cp -rn "$sys"/. "$TESSDIR"/ 2>/dev/null
  fi
  for l in ${lang//+/ }; do
    [ -s "$TESSDIR/$l.traineddata" ] && continue
    say "Til maʼlumoti yuklanmoqda: ${B}$l${N}…"
    if ! curl -fsSL "$TESSDATA_URL/$l.traineddata" -o "$TESSDIR/$l.traineddata.tmp" || [ ! -s "$TESSDIR/$l.traineddata.tmp" ]; then
      rm -f "$TESSDIR/$l.traineddata.tmp"
      err "«$l» til maʼlumotini yuklab boʻlmadi. Til nomi toʻgʻrimi (tur, uzb, uzb_cyrl, eng)? Internet bormi?"
      return 1
    fi
    mv -f "$TESSDIR/$l.traineddata.tmp" "$TESSDIR/$l.traineddata"
  done
}

ocr_run() {
  local folder="$1" out="$2" small="$3" norot="$4" lang="$5" tmp res n sk base
  ocr_setup "$lang" || return 1
  tmp=$(mktemp -d)
  res=$("$PY" -I -c "$PYNORM" "$folder" "$tmp" "$small" "$norot" 2>&1) || { err "Rasmlarni tayyorlab boʻlmadi: ${res##*$'\n'}"; rm -rf "$tmp"; return 1; }
  read -r n sk <<<"$res"
  [ "${n:-0}" -gt 0 ] 2>/dev/null || { err "Papkada rasm yoʻq (jpg, png, webp)."; rm -rf "$tmp"; return 1; }
  [ -n "$sk" ] && warn "Oʻqib boʻlmadigan rasmlar oʻtkazib yuborildi: $sk"
  say "$n sahifa matni taniladi (til: ${B}$lang${N}). Telefonda ~5–20 soniya/sahifa — kuting…"
  command -v termux-wake-lock >/dev/null && termux-wake-lock 2>/dev/null
  base="${out%.pdf}"
  local cur=0 line
  tesseract "$tmp/list.txt" "$tmp/natija" -l "$lang" --tessdata-dir "$TESSDIR" pdf txt 2>&1 | while IFS= read -r line; do
    case "$line" in Page*) cur=$((cur + 1)); printf '\r  %s/%s sahifa…' "$cur" "$n" >&2 ;; esac
  done
  printf '\r%*s\r' 40 '' >&2
  command -v termux-wake-unlock >/dev/null && termux-wake-unlock 2>/dev/null
  if [ ! -s "$tmp/natija.pdf" ]; then
    err "OCR bajarilmadi."; rm -rf "$tmp"; return 1
  fi
  mv -f "$tmp/natija.pdf" "$base.pdf"; mv -f "$tmp/natija.txt" "$base.txt" 2>/dev/null
  rm -rf "$tmp"
  command -v termux-media-scan >/dev/null && timeout 20 termux-media-scan "$base.pdf" >/dev/null 2>&1
  local words; words=$(wc -w <"$base.txt" 2>/dev/null | tr -d ' ')
  ok "${B}$(basename "$base").pdf${N}: $n sahifa, matn taniladi (${words:-0} soʻz)"
  say "${base#/storage/emulated/0/}.pdf  + .txt"
  echo "  PDF ichidan qidirish va matnni nusxalash mumkin. Toza matn: $(basename "$base").txt"
  echo "  ${Y}Tekshiring:${N} OCR xato qilishi mumkin (ayniqsa xira rasm, oʻʻ gʻ belgilari)."
}

main() {
  local small=0 norot=0 ocr=0 lang=tur a args=()
  while [ $# -gt 0 ]; do
    a="$1"; shift
    case "$a" in
      -h|--help|yordam) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; return 0 ;;
      -k) small=1 ;;
      -kk|-K) small=2 ;;
      -r) norot=1 ;;
      -o|--ocr) ocr=1 ;;
      -l) lang="${1:-}"; [ -n "$lang" ] || { err "-l dan keyin til yozing: tur, uzb, eng"; return 1; }; shift; ocr=1 ;;
      *) args+=("$a") ;;
    esac
  done
  case "$lang" in *[!a-zA-Z_+]*|"") err "Notoʻgʻri til: $lang (masalan: tur, uzb, tur+eng)"; return 1 ;; esac
  "$PY" -c "import PIL" 2>/dev/null || {
    say "Pillow oʻrnatilmoqda (bir marta)…"
    command -v pkg >/dev/null && yes | pkg install -y python-pillow >/dev/null 2>&1
    "$PY" -c "import PIL" 2>/dev/null || { err "Pillow oʻrnatilmadi. Termux'da: pkg install python-pillow"; return 1; }
  }
  local dl="" d folder name out
  for d in /storage/emulated/0/Download "$HOME/storage/downloads"; do [ -d "$d" ] && { dl="$d"; break; }; done
  folder="${args[0]:-}"
  if [ -z "$folder" ]; then
    [ -n "$dl" ] || { err "Xotiraga ruxsat yoʻq. Termux'da: termux-setup-storage"; return 1; }
    folder="$dl/Kitob"
    if [ ! -d "$folder" ]; then
      mkdir -p "$folder"
      err "Rasmlar uchun papka yaratildi: Download/Kitob"
      echo "  Kitob sahifalari rasmini shu papkaga joylang (yoki: pdf <papka>), keyin yana ${B}pdf${N}."
      return 1
    fi
  elif [ ! -d "$folder" ]; then
    # Nisbiy nom: Download ichidan qidiramiz
    if [ -n "$dl" ] && [ -d "$dl/$folder" ]; then folder="$dl/$folder"; else err "Papka topilmadi: $folder"; return 1; fi
  fi
  folder="${folder%/}"
  name="${args[1]:-$(basename "$folder")}"; name="${name%.pdf}"
  out="$folder/$name.pdf"

  say "Rasmlar: ${B}${folder#/storage/emulated/0/}${N}"
  [ "$ocr" = 1 ] && { ocr_run "$folder" "$out" "$small" "$norot" "$lang"; return; }
  local res rc
  res=$("$PY" -I -c "$PYCODE" "$folder" "$out" "$small" "$norot" 2>&1); rc=$?
  case "$rc:$res" in
    3:*) err "Papkada rasm yoʻq (jpg, png, webp)."; return 1 ;;
    4:*) err "Rasmlarni oʻqib boʻlmadi."; return 1 ;;
    0:OK*) ;;
    *) err "PDF yasab boʻlmadi: ${res##*$'\n'}"; return 1 ;;
  esac
  local pages size orig sk
  read -r _ pages size orig sk <<<"$res"
  ok "${B}$name.pdf${N}: $pages sahifa, $(human "$size")"
  if [ "${orig:-0}" -gt 0 ] 2>/dev/null; then
    echo "  Rasmlar jami: $(human "$orig") → PDF: ${B}$(human "$size")${N}"
    [ "$small" = 0 ] && [ "$size" -gt 5000000 ] 2>/dev/null && echo "  ${Y}Kichikroq fayl kerakmi?${N} ${B}pdf -k${N} yoki ${B}pdf -kk${N}"
  fi
  [ -n "$sk" ] && warn "Oʻqib boʻlmadigan rasmlar oʻtkazib yuborildi: $sk"
  say "${out#/storage/emulated/0/}"
  command -v termux-media-scan >/dev/null && timeout 20 termux-media-scan "$out" >/dev/null 2>&1
  return 0
}

main "$@"
