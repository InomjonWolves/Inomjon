#!/usr/bin/env bash
# Bosh ekran tugmasi (Termux:Widget): Download/Kitob dagi rasmlarni ketma-ketlikda bitta PDF ga jamlaydi
# va matnni taniydi (OCR, til: turkcha). PDF ichidan qidirish/nusxalash mumkin, .txt ham yoziladi.
# Boshqa til uchun Termux'da: pdf -l uzb. Oʻrnatiladi: ~/.shortcuts/Kitob-OCR
PDF="${PREFIX:-/data/data/com.termux/files/usr}/bin/pdf"
command -v pdf >/dev/null && PDF=$(command -v pdf)
if [ -x "$PDF" ]; then
  "$PDF" -o
else
  echo "pdf buyrugʻi topilmadi. Termux'da yozing: yt yangilash"
fi
echo
( : </dev/tty ) 2>/dev/null && read -r -p "Oynani yopish uchun Enter bosing… " _ </dev/tty
